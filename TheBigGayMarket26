<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Big Gay Pride Market Vendor Guide</title>
  <meta name="description" content="A mobile-friendly, map-ordered vendor guide for The Big Gay Pride Market." />

  <style>
    :root {
      --ink: #21142f;
      --muted: #65566f;
      --paper: #fffaff;
      --card: rgba(255, 255, 255, 0.93);
      --shadow: 0 14px 34px rgba(40, 14, 64, 0.14);

      --rainbow: linear-gradient(
        90deg,
        #e40303,
        #ff8c00,
        #ffed00,
        #008026,
        #24408e,
        #732982
      );

      --progress-pride: linear-gradient(
        90deg,
        #000000,
        #784f17,
        #e40303,
        #ff8c00,
        #ffed00,
        #008026,
        #24408e,
        #732982,
        #7acbf5,
        #eaacb8,
        #ffffff
      );

      --soft-pride: linear-gradient(135deg, #fff6ff, #f7fbff 45%, #fff8ed);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      color: var(--ink);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 10% 12%, rgba(255, 0, 128, 0.18), transparent 32%),
        radial-gradient(circle at 90% 8%, rgba(0, 190, 255, 0.18), transparent 30%),
        radial-gradient(circle at 50% 0%, rgba(255, 237, 0, 0.12), transparent 36%),
        var(--soft-pride);
      min-height: 100vh;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      opacity: 0.11;
      background: repeating-linear-gradient(
        135deg,
        #e40303 0 18px,
        #ff8c00 18px 36px,
        #ffed00 36px 54px,
        #008026 54px 72px,
        #24408e 72px 90px,
        #732982 90px 108px
      );
    }

    .top-stripe {
      height: 14px;
      background: var(--progress-pride);
    }

    .wrap {
      width: min(1180px, calc(100% - 28px));
      margin: 0 auto;
    }

    header {
      padding: 32px 0 18px;
    }

    .hero {
      position: relative;
      overflow: hidden;
      padding: 30px;
      border-radius: 32px;
      background: var(--card);
      box-shadow: var(--shadow);
      border: 2px solid rgba(255, 255, 255, 0.86);
    }

    .hero::after {
      content: "BIG GAY";
      position: absolute;
      top: -26px;
      right: -22px;
      z-index: 0;
      font-size: clamp(70px, 15vw, 168px);
      line-height: 0.9;
      font-weight: 1000;
      letter-spacing: -0.08em;
      opacity: 0.11;
      transform: rotate(-4deg);
      background: var(--progress-pride);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      white-space: nowrap;
    }

    .hero > * {
      position: relative;
      z-index: 1;
    }

    h1 {
      margin: 0;
      max-width: 890px;
      font-size: clamp(2.2rem, 5.4vw, 5.05rem);
      line-height: 0.92;
      letter-spacing: -0.07em;
    }

    .rainbow-text {
      background: var(--progress-pride);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .dek {
      max-width: 860px;
      margin: 16px 0 0;
      color: var(--muted);
      font-size: 1.06rem;
      line-height: 1.55;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 20px;
    }

    .button,
    button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 10px 15px;
      border-radius: 999px;
      border: 2px solid rgba(33, 20, 47, 0.14);
      background: #ffffff;
      color: var(--ink);
      font: inherit;
      font-weight: 850;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 7px 16px rgba(40, 14, 64, 0.08);
    }

    .button.pride {
      background: var(--progress-pride);
      color: white;
      border-color: transparent;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.38);
    }

    .button:hover,
    button:hover {
      transform: translateY(-1px);
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(130px, 1fr));
      gap: 10px;
      margin-top: 18px;
      max-width: 860px;
    }

    .stat {
      padding: 12px 14px;
      border-radius: 18px;
      background: rgba(255,255,255,.78);
      border: 1px solid rgba(33,20,47,.10);
    }

    .stat strong {
      display: block;
      font-size: 1.55rem;
      line-height: 1;
    }

    .stat span {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: .78rem;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: .07em;
    }

    .schedule {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin: 18px 0;
    }

    .schedule-card {
      position: relative;
      overflow: hidden;
      padding: 14px;
      border-radius: 20px;
      background: white;
      box-shadow: 0 8px 18px rgba(40,14,64,.08);
      border: 1px solid rgba(33,20,47,.10);
    }

    .schedule-card::before {
      content: "";
      position: absolute;
      inset: 0 0 auto 0;
      height: 7px;
      background: var(--progress-pride);
    }

    .schedule-card strong {
      display: block;
      margin-top: 6px;
      font-size: 1.05rem;
    }

    .schedule-card span {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: .86rem;
      line-height: 1.35;
    }

    .map-panel {
      margin: 16px 0 18px;
      border-radius: 24px;
      overflow: hidden;
      background: rgba(255,255,255,.86);
      border: 1px solid rgba(33,20,47,.12);
      box-shadow: 0 10px 24px rgba(40,14,64,.10);
    }

    .map-panel summary {
      padding: 14px 16px;
      cursor: pointer;
      font-weight: 950;
      list-style: none;
    }

    .map-panel summary::-webkit-details-marker {
      display: none;
    }

    .map-panel summary::after {
      content: "↓";
      float: right;
      font-weight: 1000;
    }

    .map-panel[open] summary::after {
      content: "↑";
    }

    .map-panel img {
      display: block;
      width: 100%;
      height: auto;
      border-top: 1px solid rgba(33,20,47,.10);
      background: white;
    }

    .controls {
      position: sticky;
      top: 0;
      z-index: 20;
      margin: 18px 0;
      padding: 14px;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.86);
      backdrop-filter: blur(14px);
      box-shadow: 0 10px 24px rgba(40, 14, 64, 0.1);
      border: 1px solid rgba(33, 20, 47, 0.12);
    }

    .control-grid {
      display: grid;
      grid-template-columns: 1.3fr .95fr .9fr .9fr auto auto;
      gap: 10px;
      align-items: end;
    }

    label.small {
      display: block;
      margin: 0 0 5px 4px;
      color: var(--muted);
      font-size: 0.74rem;
      font-weight: 950;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    input,
    select {
      width: 100%;
      min-height: 44px;
      padding: 10px 13px;
      border-radius: 16px;
      border: 2px solid rgba(33, 20, 47, 0.16);
      background: white;
      color: var(--ink);
      font: inherit;
    }

    .toggle {
      display: flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      padding: 10px 12px;
      border-radius: 16px;
      background: white;
      border: 2px solid rgba(33, 20, 47, 0.12);
      font-weight: 850;
      white-space: nowrap;
    }

    .toggle input {
      width: auto;
      min-height: auto;
    }

    .result-line {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
      margin-top: 12px;
      color: var(--muted);
      font-size: .88rem;
      font-weight: 750;
    }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 11px;
      border-radius: 999px;
      background: white;
      border: 2px solid rgba(33, 20, 47, 0.12);
      color: var(--ink);
      font-size: 0.82rem;
      font-weight: 850;
      cursor: pointer;
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease,
        background 0.15s ease;
    }

    .pill:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 16px rgba(40, 14, 64, 0.1);
    }

    .pill.active {
      border-color: var(--cat-color);
      background: color-mix(in srgb, var(--cat-color) 16%, white);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--cat-color) 18%, transparent);
    }

    .pill.active::after {
      content: "✓";
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 999px;
      background: var(--cat-color);
      color: white;
      font-size: 0.72rem;
      font-weight: 1000;
    }

    .dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--cat-color);
      flex: 0 0 auto;
    }

    .route {
      display: grid;
      grid-template-columns: repeat(5, minmax(150px, 1fr));
      gap: 8px;
      margin: 18px 0;
    }

    .route a {
      position: relative;
      overflow: hidden;
      min-height: 110px;
      padding: 13px;
      border-radius: 18px;
      background: white;
      color: var(--ink);
      text-decoration: none;
      box-shadow: 0 8px 18px rgba(40, 14, 64, 0.08);
    }

    .route a::before {
      content: "";
      position: absolute;
      inset: 0 0 auto 0;
      height: 7px;
      background: var(--rainbow);
    }

    .route strong {
      display: block;
      margin-top: 6px;
      font-size: 0.95rem;
      line-height: 1.15;
    }

    .route span {
      display: block;
      margin-top: 5px;
      color: var(--muted);
      font-size: 0.78rem;
      line-height: 1.25;
    }

    .route .count {
      display: inline-flex;
      width: fit-content;
      margin-top: 8px;
      padding: 4px 8px;
      border-radius: 999px;
      background: rgba(33,20,47,.08);
      color: var(--ink);
      font-weight: 950;
    }

    main {
      padding: 8px 0 60px;
    }

    .block {
      margin: 26px 0;
      overflow: hidden;
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(33, 20, 47, 0.1);
      box-shadow: var(--shadow);
      scroll-margin-top: 106px;
    }

    .block-head {
      padding: 19px 22px;
      background:
        linear-gradient(90deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.72)),
        var(--rainbow);
      border-bottom: 1px solid rgba(33, 20, 47, 0.1);
    }

    .block-head h2 {
      margin: 0;
      font-size: clamp(1.35rem, 3vw, 2.1rem);
      letter-spacing: -0.04em;
    }

    .block-head small {
      font-size: .62em;
      color: var(--muted);
      letter-spacing: -0.01em;
    }

    .block-head p {
      margin: 6px 0 0;
      color: var(--muted);
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(258px, 1fr));
      gap: 14px;
      padding: 16px;
    }

    .card {
      position: relative;
      min-height: 214px;
      padding: 16px 16px 16px 18px;
      border-radius: 21px;
      background: white;
      border: 2px solid color-mix(in srgb, var(--cat-color) 38%, white);
      box-shadow: 0 10px 24px rgba(40, 14, 64, 0.08);
    }

    .card::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 8px;
      border-radius: 21px 0 0 21px;
      background: var(--cat-color);
    }

    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
    }

    .booth {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 54px;
      height: 36px;
      padding: 0 10px;
      border-radius: 14px;
      background: var(--cat-color);
      color: white;
      font-weight: 1000;
      box-shadow: inset 0 -1px 0 rgba(0,0,0,.18);
    }

    .badges {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 6px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 28px;
      padding: 5px 8px;
      border-radius: 999px;
      background: rgba(33,20,47,.07);
      color: var(--muted);
      font-size: .72rem;
      font-weight: 900;
      white-space: nowrap;
    }

    .badge.day {
      background: #fff3a8;
      color: #5f4200;
    }

    .badge.no-url {
      background: #f1eef4;
      color: #6b6075;
    }

    .pick {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 999px;
      background: #fff3a8;
      border: 2px solid #ffd43b;
    }

    .card h3 {
      margin: 12px 0 6px;
      font-size: 1.12rem;
      line-height: 1.16;
      letter-spacing: -0.025em;
    }

    .category-tag {
      display: inline-flex;
      margin-bottom: 10px;
      padding: 5px 9px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--cat-color) 14%, white);
      color: color-mix(in srgb, var(--cat-color) 70%, black);
      font-size: 0.78rem;
      font-weight: 950;
    }

    .desc {
      margin: 0;
      color: var(--muted);
      font-size: 0.94rem;
      line-height: 1.45;
    }

    .visit {
      display: inline-flex;
      margin-top: 14px;
      color: var(--ink);
      font-weight: 950;
      text-decoration: none;
      border-bottom: 3px solid var(--cat-color);
    }

    .no-link {
      display: inline-flex;
      margin-top: 14px;
      color: var(--muted);
      font-weight: 850;
      font-size: .88rem;
    }

    .empty {
      display: none;
      margin: 34px 0;
      padding: 28px;
      border-radius: 24px;
      background: white;
      text-align: center;
      color: var(--muted);
      box-shadow: var(--shadow);
    }

    .back-top {
      position: fixed;
      right: 14px;
      bottom: 14px;
      z-index: 30;
      width: 48px;
      height: 48px;
      padding: 0;
      border-radius: 999px;
      background: var(--progress-pride);
      color: white;
      border: 0;
      text-shadow: 0 1px 2px rgba(0,0,0,.4);
    }

    footer {
      padding: 26px 0 44px;
      color: var(--muted);
      text-align: center;
    }

    footer a {
      color: var(--ink);
      font-weight: 900;
    }

    @media (max-width: 1050px) {
      .control-grid {
        grid-template-columns: 1fr 1fr 1fr;
      }

      .route {
        grid-template-columns: repeat(3, minmax(150px, 1fr));
      }
    }

    @media (max-width: 760px) {
      header {
        padding-top: 22px;
      }

      .hero {
        padding: 22px;
        border-radius: 26px;
      }

      .stats,
      .schedule {
        grid-template-columns: 1fr 1fr;
      }

      .controls {
        position: relative;
      }

      .control-grid {
        grid-template-columns: 1fr;
      }

      .route {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding-bottom: 6px;
      }

      .route a {
        flex: 0 0 210px;
        scroll-snap-align: start;
      }

      .cards {
        grid-template-columns: 1fr;
        padding: 12px;
      }

      .block {
        scroll-margin-top: 12px;
      }
    }

    @media (max-width: 520px) {
      .wrap {
        width: min(100% - 20px, 1180px);
      }

      h1 {
        font-size: clamp(2rem, 13vw, 3.4rem);
      }

      .dek {
        font-size: .99rem;
      }

      .stats,
      .schedule {
        grid-template-columns: 1fr;
      }

      .legend {
        max-height: 220px;
        overflow: auto;
        padding-right: 3px;
      }

      .card {
        min-height: auto;
      }

      .card-top {
        align-items: center;
      }
    }

    @media print {
      body {
        background: white;
      }

      body::before,
      .top-stripe,
      .controls,
      .hero-actions,
      .route,
      .map-panel,
      .back-top,
      footer {
        display: none !important;
      }

      .wrap {
        width: 100%;
      }

      .hero,
      .block,
      .card {
        box-shadow: none;
      }

      .hero {
        padding: 0 0 10px;
        border: 0;
      }

      .hero::after {
        display: none;
      }

      h1 {
        font-size: 32px;
      }

      .dek {
        margin-top: 6px;
        font-size: 11px;
      }

      .stats,
      .schedule {
        display: none;
      }

      .block {
        break-inside: avoid;
        margin: 10px 0;
        border: 1px solid #dddddd;
      }

      .block-head {
        padding: 9px 12px;
      }

      .block-head h2 {
        font-size: 16px;
      }

      .block-head p {
        font-size: 10px;
      }

      .cards {
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
        padding: 8px;
      }

      .card {
        min-height: auto;
        padding: 8px 8px 8px 12px;
        border-width: 1px;
      }

      .booth {
        min-width: 34px;
        height: 24px;
        font-size: 11px;
      }

      .badge {
        font-size: 9px;
        min-height: 20px;
        padding: 2px 5px;
      }

      .card h3 {
        margin: 6px 0 4px;
        font-size: 12px;
      }

      .category-tag {
        margin-bottom: 4px;
        padding: 2px 5px;
        font-size: 9px;
      }

      .desc {
        font-size: 9px;
        line-height: 1.25;
      }

      .visit,
      .no-link {
        display: none;
      }
    }
  </style>
</head>

<body>
  <div class="top-stripe" aria-hidden="true"></div>

  <header class="wrap" id="top">
    <section class="hero">
      <h1>
        Big Gay Pride Market
        <span class="rainbow-text">Vendor Guide</span>
      </h1>

      <p class="dek">
        A mobile-friendly, map-ordered guide for wandering The Big Gay Pride Market with Porter.
        Start near the entrance, sweep the front hallway, then move through the main hall by booth hundreds.
        Filter by category, search by name or booth, and mark Parker + Porter picks in phase two.
      </p>

      <div class="hero-actions">
        <a
          class="button pride"
          href="https://www.thebiggaymarketllc.com/pride-market"
          target="_blank"
          rel="noopener"
        >
          Open official event page
        </a>

        <a class="button" href="#map">
          Open map
        </a>

        <button type="button" onclick="window.print()">
          Print this guide
        </button>
      </div>

      <div class="stats" aria-label="Guide stats">
        <div class="stat">
          <strong>244</strong>
          <span>vendor rows</span>
        </div>
        <div class="stat">
          <strong>19</strong>
          <span>categories</span>
        </div>
        <div class="stat">
          <strong>233</strong>
          <span>links found</span>
        </div>
        <div class="stat">
          <strong>11</strong>
          <span>need links</span>
        </div>
      </div>
    </section>

    <section class="schedule" aria-label="Market schedule">
      <div class="schedule-card">
        <strong>Friday</strong>
        <span>5pm-10pm market open, 18+.</span>
      </div>
      <div class="schedule-card">
        <strong>Saturday</strong>
        <span>10am-5pm market open, plus youth fair, seminars, drag bingo, and shows.</span>
      </div>
      <div class="schedule-card">
        <strong>Sunday</strong>
        <span>10am-2pm market open. Masks required Sunday.</span>
      </div>
    </section>

    <details class="map-panel" id="map">
      <summary>Official market map: entrance, side rooms, hallway, and main hall</summary>
      <img src="pride_market_map.png" alt="Official Big Gay Pride Market map showing entrance, side rooms, hallway booths, seating, food and drink, bathrooms, and the main vendor hall." />
    </details>

    <section class="controls" aria-label="Vendor filters">
      <div class="control-grid">
        <div>
          <label class="small" for="search">Search vendors</label>
          <input
            id="search"
            type="search"
            placeholder="Search name, booth, category, description..."
            autocomplete="off"
          />
        </div>

        <div>
          <label class="small" for="category">Filter by category</label>
          <select id="category">
            <option value="all">All categories</option>
          </select>
        </div>

        <div>
          <label class="small" for="dayFilter">Day / availability</label>
          <select id="dayFilter">
            <option value="all">All day notes</option>
          </select>
        </div>

        <div>
          <label class="small" for="sortMode">Sort / view</label>
          <select id="sortMode">
            <option value="walking">Walking order</option>
            <option value="booth">Booth number</option>
            <option value="name">Vendor A-Z</option>
            <option value="category">Category</option>
          </select>
        </div>

        <label class="toggle">
          <input id="pickOnly" type="checkbox" />
          ⭐ Picks
        </label>

        <button type="button" id="clearFilters">
          Clear filters
        </button>
