    const guide = document.getElementById("guide");
    const empty = document.getElementById("empty");
    const categorySelect = document.getElementById("category");
    const dayFilter = document.getElementById("dayFilter");
    const sortMode = document.getElementById("sortMode");
    const searchInput = document.getElementById("search");
    const pickOnlyInput = document.getElementById("pickOnly");
    const clearButton = document.getElementById("clearFilters");
    const legend = document.getElementById("legend");
    const route = document.getElementById("route");
    const resultCount = document.getElementById("resultCount");

    let selectedCategories = new Set();

    function escapeHtml(value) {
      return String(value ?? "").replace(/[&<>"']/g, function (character) {
        return {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"
        }[character];
      });
    }

    function normalize(value) {
      return String(value ?? "").trim().toLowerCase();
    }

    function vendorMatchesFilters(vendor) {
      const selectedCategory = categorySelect.value;
      const selectedDay = dayFilter.value;
      const searchTerm = normalize(searchInput.value);
      const pickOnly = pickOnlyInput.checked;

      const searchableText = [
        vendor.booth,
        vendor.boothLabel,
        vendor.name,
        vendor.category,
        vendor.description,
        vendor.day,
        vendor.tags,
        vendor.status
      ].join(" ").toLowerCase();

      const dropdownIsAll = selectedCategory === "all";
      const dayIsAll = selectedDay === "all";
      const pillFiltersAreActive = selectedCategories.size > 0;

      const matchesDropdown =
        dropdownIsAll || vendor.category === selectedCategory;

      const matchesDay =
        dayIsAll || vendor.day === selectedDay;

      const matchesPillFilters =
        !pillFiltersAreActive || selectedCategories.has(vendor.category);

      const matchesSearch =
        searchTerm === "" || searchableText.includes(searchTerm);

      const matchesPick =
        !pickOnly || vendor.pick === true;

      return matchesDropdown && matchesDay && matchesPillFilters && matchesSearch && matchesPick;
    }

    function compareVendors(a, b, mode) {
      if (mode === "name") {
        return a.name.localeCompare(b.name);
      }

      if (mode === "category") {
        return a.category.localeCompare(b.category) || a.name.localeCompare(b.name);
      }

      if (mode === "booth") {
        return (a.booth ?? 9999) - (b.booth ?? 9999) || a.name.localeCompare(b.name);
      }

      return (a.blockOrder - b.blockOrder) || (a.booth ?? 9999) - (b.booth ?? 9999) || a.name.localeCompare(b.name);
    }

    function vendorCard(vendor) {
      const color = CATEGORY_COLORS[vendor.category] || "#777777";
      const url = vendor.url && vendor.url !== "No URL" ? vendor.url : "";
      const dayBadge = vendor.day && vendor.day !== "Standard booth / verify days"
        ? `<span class="badge day">${escapeHtml(vendor.day)}</span>`
        : "";
      const noUrlBadge = url ? "" : `<span class="badge no-url">Needs URL</span>`;

      const link = url
        ? `<a class="visit" href="${escapeHtml(url)}" target="_blank" rel="noopener">Visit shop ↗</a>`
        : `<span class="no-link">No URL yet</span>`;

      const pick = vendor.pick
        ? `<span class="pick" title="Parker + Porter pick">⭐</span>`
        : "";

      return `
        <article class="card" style="--cat-color: ${color}">
          <div class="card-top">
            <span class="booth">${escapeHtml(vendor.boothLabel || vendor.booth)}</span>
            <div class="badges">
              ${pick}
              ${dayBadge}
              ${noUrlBadge}
            </div>
          </div>

          <h3>${escapeHtml(vendor.name)}</h3>

          <span class="category-tag">
            ${escapeHtml(vendor.category)}
          </span>

          <p class="desc">
            ${escapeHtml(vendor.description)}
          </p>

          ${link}
        </article>
      `;
    }

    function renderWalkingBlocks(filteredVendors) {
      return BLOCKS.map(function (block) {
        const vendorsInBlock = filteredVendors
          .filter(function (vendor) {
            return vendor.block === block.id;
          })
          .sort(function (a, b) {
            return compareVendors(a, b, "walking");
          });

        if (vendorsInBlock.length === 0) {
          return "";
        }

        return `
          <section class="block" id="${escapeHtml(block.id)}">
            <div class="block-head">
              <h2>${escapeHtml(block.title)} <small>• ${escapeHtml(block.range)} • ${vendorsInBlock.length} shown</small></h2>
              <p>${escapeHtml(block.description)}</p>
            </div>

            <div class="cards">
              ${vendorsInBlock.map(vendorCard).join("")}
            </div>
          </section>
        `;
      }).join("");
    }

    function renderSortedBlock(filteredVendors, mode) {
      const sorted = filteredVendors.slice().sort(function (a, b) {
        return compareVendors(a, b, mode);
      });

      const titleMap = {
        booth: "All Matching Vendors by Booth Number",
        name: "All Matching Vendors A-Z",
        category: "All Matching Vendors by Category"
      };

      return `
        <section class="block" id="sorted-results">
          <div class="block-head">
            <h2>${titleMap[mode] || "All Matching Vendors"} <small>• ${sorted.length} shown</small></h2>
            <p>Switch back to walking order when you want the map-friendly route.</p>
          </div>

          <div class="cards">
            ${sorted.map(vendorCard).join("")}
          </div>
        </section>
      `;
    }

    function renderGuide() {
      const mode = sortMode.value;
      const filteredVendors = VENDORS.filter(vendorMatchesFilters);

      if (mode === "walking") {
        guide.innerHTML = renderWalkingBlocks(filteredVendors);
      } else {
        guide.innerHTML = filteredVendors.length ? renderSortedBlock(filteredVendors, mode) : "";
      }

      empty.style.display = filteredVendors.length === 0 ? "block" : "none";

      const pickMessage = pickOnlyInput.checked && filteredVendors.length === 0
        ? "No Parker + Porter picks have been marked yet. Phase two sparkle pending."
        : `${filteredVendors.length} of ${VENDORS.length} vendors showing`;

      resultCount.textContent = pickMessage;
    }

    function buildCategoryDropdown() {
      const categories = Array.from(new Set(VENDORS.map(function (vendor) {
        return vendor.category;
      }))).sort();

      categories.forEach(function (category) {
        const option = document.createElement("option");
        option.value = category;
        option.textContent = category + " (" + VENDORS.filter(v => v.category === category).length + ")";
        categorySelect.appendChild(option);
      });
    }

    function buildDayDropdown() {
      const days = Array.from(new Set(VENDORS.map(function (vendor) {
        return vendor.day || "Standard booth / verify days";
      }))).sort();

      days.forEach(function (day) {
        const option = document.createElement("option");
        option.value = day;
        option.textContent = day + " (" + VENDORS.filter(v => v.day === day).length + ")";
        dayFilter.appendChild(option);
      });
    }

    function buildLegend() {
      const categories = Array.from(new Set(VENDORS.map(function (vendor) {
        return vendor.category;
      }))).sort();

      legend.innerHTML = categories.map(function (category) {
        return `
          <button
            type="button"
            class="pill category-pill"
            style="--cat-color: ${CATEGORY_COLORS[category] || "#777777"}"
            data-category="${escapeHtml(category)}"
            aria-pressed="false"
          >
            <span class="dot"></span>
            ${escapeHtml(category)}
          </button>
        `;
      }).join("");

      document.querySelectorAll(".category-pill").forEach(function (button) {
        button.addEventListener("click", function () {
          const category = button.dataset.category;

          if (selectedCategories.has(category)) {
            selectedCategories.delete(category);
            button.classList.remove("active");
            button.setAttribute("aria-pressed", "false");
          } else {
            selectedCategories.add(category);
            button.classList.add("active");
            button.setAttribute("aria-pressed", "true");
          }

          renderGuide();
        });
      });
    }

    function buildRoute() {
      route.innerHTML = BLOCKS.map(function (block) {
        return `
          <a href="#${escapeHtml(block.id)}">
            <strong>${escapeHtml(block.title)}</strong>
            <span>${escapeHtml(block.range)}</span>
            <span>${escapeHtml(block.mapNote)}.</span>
            <span class="count">${block.count} vendors</span>
          </a>
        `;
      }).join("");
    }

    function clearFilters() {
      categorySelect.value = "all";
      dayFilter.value = "all";
      sortMode.value = "walking";
      searchInput.value = "";
      pickOnlyInput.checked = false;
      selectedCategories.clear();

      document.querySelectorAll(".category-pill").forEach(function (button) {
        button.classList.remove("active");
        button.setAttribute("aria-pressed", "false");
      });

      renderGuide();
    }

    categorySelect.addEventListener("change", renderGuide);
    dayFilter.addEventListener("change", renderGuide);
    sortMode.addEventListener("change", renderGuide);
    searchInput.addEventListener("input", renderGuide);
    pickOnlyInput.addEventListener("change", renderGuide);
    clearButton.addEventListener("click", clearFilters);

    buildCategoryDropdown();
    buildDayDropdown();
    buildLegend();
    buildRoute();
    renderGuide();
  </script>
</body>
</html>
